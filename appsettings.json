{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Cors": {
    "AllowedOrigins": [
      "https://anterapp.com",
      "https://www.anterapp.com"
    ]
  },

  "MongoDB": {
    "DatabaseName": "AnteraDb"
  },

  "Jwt": {
    "Issuer": "AnteraApp.Api",
    "Audience": "AnteraApp.Client",
    "ExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 30
  }
}
